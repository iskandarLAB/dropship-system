# Copy to .env and fill in. NEVER commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Public base URL of this site (used for CHIP callbacks/redirects). Must be HTTPS in production.
SITE_URL=http://127.0.0.1:8000

# "dummy" = fake FPX page for local testing, "chip" = real CHIP Collect
PAYMENT_GATEWAY=dummy

# From https://portal.chip-in.asia -> Developers
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
# Optional. If empty, fetched automatically from GET /public_key/
CHIP_PUBLIC_KEY=

STOCK_STALE_HOURS=24
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_AUTO_COMPLETE_DAYS=14
